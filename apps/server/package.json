{
  "name": "@laofi/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=../../.env src/seed.ts",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset --force --skip-seed",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@colyseus/core": "~0.18.25",
    "@colyseus/schema": "^5.0.43",
    "@colyseus/ws-transport": "~0.18.4",
    "@fastify/cookie": "^11.1.5",
    "@laofi/shared": "workspace:*",
    "@prisma/client": "6.19.3",
    "fastify": "^5.12.8",
    "jose": "^6.2.15",
    "livekit-server-sdk": "^2.19.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@colyseus/sdk": "~0.18.9",
    "dotenv-cli": "^11.1.0",
    "prisma": "6.19.3",
    "tsx": "^4.23.15"
  }
}
