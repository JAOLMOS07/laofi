# Copia este archivo a .env y ajusta los valores. Nunca subas .env al repo.

# Servidor multijugador (Colyseus) y API REST
SERVER_PORT=2567
API_PORT=2568
# Clave para firmar las sesiones. En producción es obligatoria: pon una larga y aleatoria.
SESSION_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria
# URL del servidor multijugador que usa el navegador (déjala vacía para usar el mismo host, puerto 2567)
VITE_SERVER_URL=ws://localhost:2567

# Base de datos (Docker Compose levanta este Postgres)
POSTGRES_USER=laofi
POSTGRES_PASSWORD=laofi_dev
POSTGRES_DB=laofi
DATABASE_URL=postgresql://laofi:laofi_dev@localhost:5432/laofi
REDIS_URL=redis://localhost:6379

# Voz (opcional). Sin estas tres variables la app funciona sin audio: el walkie muestra quién habla
# y las salas ofrecen "Abrir en Teams". Para probar voz: docker compose --profile voz up livekit
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret
